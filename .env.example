# Copy to .env and fill in. .env is gitignored: never commit real keys.

# Which version of PIVOT: api (Muse and SAM 3.1 through the Meta API, needs a key)
# or open (open weights on your own GPU: Llama via vLLM, SAM 3.1 self-hosted, no key)
PIVOT_BACKEND=api
# open version: address of the vLLM server (scripts/cluster/llama_server.sbatch)
PIVOT_OPEN_URL=http://localhost:8000/v1

# Meta Model API (https://dev.meta.ai/docs/authentication)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# SAM 3.1 backend, if it should differ from PIVOT_BACKEND: auto, api or local
# PIVOT_SAM_BACKEND=auto
