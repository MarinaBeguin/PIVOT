# Independent stack: vLLM resolves its own CUDA/PyTorch dependencies.
# Check this image on the host before downloading large models.
FROM vllm/vllm-openai:v0.8.5.post1
ENV HF_HOME=/cache/huggingface
# Override --model and --tool-call-parser for a model supported by this vLLM version.
CMD ["--model", "meta-llama/Llama-3.1-8B-Instruct", "--host", "0.0.0.0", "--port", "8000", "--max-model-len", "32768", "--enable-auto-tool-choice", "--tool-call-parser", "llama3_json"]
